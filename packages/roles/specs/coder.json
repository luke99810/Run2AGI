{
  "id": "coder",
  "summary": "实现 WorkPacket，产出 diff、自测结果与证据。",
  "usesModel": true,
  "promptRef": "coder.md",
  "writes": ["workspace/**"],
  "reads": ["packages/contracts/**", "tests/**", "docs/adr/**"],
  "invisible": ["evidence/**/reasoning.md"],
  "tools": ["read_file", "write_file", "run_tests", "run_build", "create_diff", "request_help"],
  "transitions": [
    { "from": "running", "to": "review", "requiresGate": "self-test" },
    { "from": "running", "to": "blocked" }
  ],
  "modelPolicy": {
    "defaultModel": "qwen-coder-plus-1106",
    "defaultEffort": "medium"
  },
  "skills": [
    { "id": "frontend", "scope": "role", "state": "active" },
    { "id": "backend", "scope": "role", "state": "active" },
    { "id": "testing", "scope": "role", "state": "active" },
    { "id": "debugging", "scope": "role", "state": "active" }
  ],
  "escalation": {
    "maxSelfRepair": 1,
    "peerDebugEnabled": true,
    "escalateTo": "helper"
  }
}
