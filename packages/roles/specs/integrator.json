{
  "id": "integrator",
  "summary": "整合已通过评审的产物，跑绿线并产出集成证据。",
  "usesModel": true,
  "promptRef": "integrator.md",
  "writes": ["evidence/integration/**", "evidence/delivery/**", ".codentum/integration/**", ".codentum/delivery/**"],
  "reads": [
    "packages/contracts/**",
    "tests/**",
    "evidence/diffs/**",
    "evidence/test-reports/**",
    "evidence/reviews/**"
  ],
  "tools": ["read_diff", "merge_changes", "run_tests", "run_build", "check_green_line", "write_integration_report"],
  "transitions": [
    { "from": "running", "to": "review", "requiresGate": "self-test" },
    { "from": "review", "to": "accepted", "requiresGate": "self-test" },
    { "from": "running", "to": "blocked" }
  ],
  "modelPolicy": {
    "defaultModel": "qwen-plus-2025-07-14",
    "defaultEffort": "low"
  },
  "skills": [
    { "id": "integration", "scope": "role", "state": "active" },
    { "id": "delivery", "scope": "role", "state": "active" },
    { "id": "testing", "scope": "role", "state": "active" },
    { "id": "review", "scope": "role", "state": "active" },
    { "id": "debugging", "scope": "role", "state": "active" }
  ]
}
