{
  "id": "reviewer",
  "summary": "对抗评审 diff、验收测试与证据，不读取 Coder 推理链。",
  "usesModel": true,
  "writes": ["evidence/reviews/**"],
  "reads": ["packages/contracts/**", "tests/**", "evidence/diffs/**", "evidence/test-reports/**"],
  "invisible": ["evidence/coder-reasoning/**"],
  "tools": ["read_file", "read_diff", "run_static_analysis", "write_review"],
  "transitions": [
    { "from": "review", "to": "accepted", "requiresGate": "review" },
    { "from": "review", "to": "rejected", "requiresGate": "review" }
  ],
  "modelPolicy": {
    "defaultModel": "qwen-max",
    "defaultEffort": "high",
    "mustDifferFrom": ["coder"]
  }
}
